# PostgreSQL connection used by the API, the worker, and the scripts.
# Inside Docker Compose the host is the service name "db"; running scripts on the
# host against the published port uses "localhost".
DATABASE_URL=postgresql://orders:orders@db:5432/orders

# Base URL the demo/consumer scripts use to reach the API.
API_BASE_URL=http://localhost:8000

# Optional: scope the example consumer to a single customer's orders.
# Leave blank to receive every accepted order.
CONSUMER_CUSTOMER_ID=cust-42

# Stock worker poll interval (seconds) and batch size per poll.
WORKER_POLL_INTERVAL=1.0
WORKER_BATCH_SIZE=50

# Optional webhook push adapter (Option A). Leave WEBHOOK_URL blank to disable.
# Set it to a Discord incoming webhook (or any endpoint) in your local .env only
# — never commit a real webhook URL.
WEBHOOK_URL=
WEBHOOK_FORMAT=discord
